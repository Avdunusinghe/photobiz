@model PublicSite

<section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="mb-8 text-3xl font-bold">Galleries</h1>

    @if (Model.Galleries.Count == 0)
    {
        <p class="text-gray-500">No galleries yet — check back soon.</p>
    }
    else
    {
        <div class="gallery-grid">
            @foreach (var gallery in Model.Galleries)
            {
                var cover = gallery.Photos.FirstOrDefault();
                <a href="~/galleries/@gallery.Id" class="group block overflow-hidden rounded-xl bg-gray-100">
                    <div class="aspect-square overflow-hidden">
                        @if (cover is not null)
                        {
                            <img src="@cover.MediumUrl" alt="@(cover.AltText ?? gallery.Title)" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                        }
                    </div>
                    <div class="p-3">
                        <h2 class="font-semibold" style="color: var(--color-primary)">@gallery.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(gallery.Description))
                        {
                            <p class="mt-1 text-sm text-gray-500">@gallery.Description</p>
                        }
                    </div>
                </a>
            }
        </div>
    }
</section>
