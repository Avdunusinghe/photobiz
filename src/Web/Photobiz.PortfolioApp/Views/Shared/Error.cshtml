@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "_ErrorLayout";
}

<h1 class="text-2xl font-bold">Something went wrong</h1>
<p class="mt-2 text-gray-600">We're sorry — please try again in a moment.</p>

@if (Model.ShowRequestId)
{
    <p class="mt-4 text-sm text-gray-400">Request ID: <code>@Model.RequestId</code></p>
}
