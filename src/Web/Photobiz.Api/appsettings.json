{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Photobiz.Api",
    "Audience": "Photobiz.Client",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Tenancy": {
    "BaseDomain": "photobiz.app"
  },
  "ConnectionStrings": {
    "MasterConnection": "Server=.;Database=PhotobizMasterDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "DefaultConnection": "Server=.;Database=PhotobizDb;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
